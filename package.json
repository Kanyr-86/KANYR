{
  "name": "kanyr",
  "version": "1.11.0",
  "description": "Ez a Ganz Ábrahám Szakközép és Technikum diákjainak a csoport projektje",
  "main": "backend/app.js",
  "scripts": {
    "test": "cd backend && npm test",
    "test:backend": "cd backend && npm test",
    "test:unit": "cd backend && npm run test:unit",
    "test:integration": "cd backend && npm run test:integration",
    "test:coverage": "cd backend && npm run test:coverage",
    "start": "cd backend && node app.js",
    "start-frontend": "cd frontend && npm run dev",
    "start-all": "concurrently \"cd backend && nodemon app.js\" \"npm run start-frontend\"",
    "build-frontend": "cd frontend && npm run build",
    "dev": "concurrently \"cd backend && nodemon app.js\" \"cd frontend && npm run dev\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kanyr-86/KANYR.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Kanyr-86/KANYR/issues"
  },
  "homepage": "https://github.com/Kanyr-86/KANYR#readme",
  "dependencies": {
    "axios": "^1.13.4",
    "bootstrap": "^5.3.8",
    "bootstrap-vue-3": "^0.5.1",
    "cors": "^2.8.6",
    "express-rate-limit": "^8.2.1",
    "kanyr-backend": "file:backend",
    "lodash-es": "^4.17.23",
    "pinia": "^3.0.4",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/supertest": "^6.0.3",
    "concurrently": "^9.2.1",
    "jest": "^27.5.1",
    "nodemon": "^3.1.11",
    "react-scripts": "^5.0.1",
    "supertest": "^7.2.2"
  }
}
