### Create a new student (requires existing parent and address IDs)
POST http://localhost:3000/api/diaks
Content-Type: application/json

{
  "nev": "Egyszerű Teszt Diák",
  "email": "egyszeru.teszt@email.hu",
  "telefonszam": "06-30-555-1234",
  "szuletesi_datum": "2005-07-20",
  "szemelyi_igazolvany_szam": "111222333",
  "taj_szam": "444555666",
  "diakigazolvany_szam": "777888999",
  "szulo_id": 1,
  "kapcsolat_tipusa": "anya",
  "cim_id": 1
}

### ========================================
### 4. CREATE PARENT AND ADDRESS (SEPARATELY)
### ========================================

### Create a new address
POST http://localhost:3000/api/lakcims
Content-Type: application/json

{
  "orszag": "Magyarország",
  "iranyitoszam": "7621",
  "varos": "Pécs",
  "utca_hazszam": "Új utca 25."
}

### Create a new parent
POST http://localhost:3000/api/szulos
Content-Type: application/json

{
  "nev": "Új Szülő Anna",
  "email": "uj.szulo.anna@email.hu",
  "telefonszam": "06-70-888-9999",
  "szemelyi_igazolvany_szam": "111111111",
  "cim_id": 1
}

### Get all parents
GET http://localhost:3000/api/szulos

### Get parent by ID
GET http://localhost:3000/api/szulos/1

### Update parent
PUT http://localhost:3000/api/szulos/1
Content-Type: application/json

{
  "nev": "Frissített Szülő Anna",
  "telefonszam": "06-70-888-0000"
}

### Delete parent
DELETE http://localhost:3000/api/szulos/1

### ========================================
### LAKCIM (ADDRESS) ENDPOINTS
### ========================================

### Get all addresses
GET http://localhost:3000/api/lakcims

### Get address by ID
GET http://localhost:3000/api/lakcims/1

### Update address
PUT http://localhost:3000/api/lakcims/1
Content-Type: application/json

{
  "utca_hazszam": "Frissített utca 26."
}

### Delete address
DELETE http://localhost:3000/api/lakcims/1

### Get addresses by city
GET http://localhost:3000/api/lakcims/city/Pécs

### ========================================
### SZULO (PARENT) ENDPOINTS
### ========================================

### Get all parents
GET http://localhost:3000/api/szulos

### Get parent by ID
GET http://localhost:3000/api/szulos/1

### Update parent
PUT http://localhost:3000/api/szulos/1
Content-Type: application/json

{
  "nev": "Frissített Szülő Anna",
  "telefonszam": "06-70-888-0000"
}

### Delete parent
DELETE http://localhost:3000/api/szulos/1


### Új szoba létrehozása
POST http://localhost:3000/api/szobas
Content-Type: application/json

{
  "szoba_szama": "A101",
  "osszes_hely": 2
}

### Új beköltözés létrehozása
POST http://localhost:3000/api/szobas/bekoltozes
Content-Type: application/json

{
  "diak_id": 1,
  "szoba_id": 1,
  "bekoltozes_datum": "2024-09-01"
}
