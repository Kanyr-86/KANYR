# KANYR Backend Environment Configuration
# Copy this file to .env and update values as needed

# Environment
NODE_ENV=development

# Server
PORT=3000

# JWT Configuration
# IMPORTANT: Change JWT_SECRET to a strong random string in production!
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars
JWT_EXPIRES_IN=24h

# CORS - Allowed Frontend Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Logging Level (debug, info, warn, error)
LOG_LEVEL=debug

# Database (SQLite - file will be created automatically)
DATABASE_URL=sqlite:./config/database.sqlite

# Admin User (For initial seeding - change in production!)
ADMIN_EMAIL=admin@kanyr.hu
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeThisPassword123

# Notes:
# - JWT_SECRET must be at least 32 characters
# - Change ADMIN_PASSWORD immediately in production
# - Add your production domain to ALLOWED_ORIGINS