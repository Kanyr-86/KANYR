# KANYR Backend Environment Configuration

# JWT Configuration
# IMPORTANT: JWT_SECRET must be at least 32 characters long and cryptographically secure.
# Generate a strong random secret using one of these commands:
#   Node.js: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
#   Linux/Mac: openssl rand -base64 64
#   PowerShell: [Convert]::ToBase64String([System.Security.Cryptography.RandomNumberGenerator]::GetBytes(64))
# NEVER use the default value in production. The app will fail to start if JWT_SECRET is not set.
JWT_SECRET=
JWT_EXPIRES_IN=24h

# Database Configuration
NODE_ENV=development

# Server Configuration
PORT=3000