# KANYR Backend Environment Configuration

# JWT Configuration
# IMPORTANT: JWT_SECRET must be at least 32 characters long and cryptographically secure.
# Generate a strong random secret using one of these commands:
#   Node.js: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
#   Linux/Mac: openssl rand -base64 64
#   PowerShell: [Convert]::ToBase64String([System.Security.Cryptography.RandomNumberGenerator]::GetBytes(64))
# NEVER use the default value in production. The app will fail to start if JWT_SECRET is not set.
JWT_SECRET=
JWT_EXPIRES_IN=24h

# JWT Payload Encryption Key
# IMPORTANT: This key is used to encrypt sensitive data in JWT tokens (AES-256-GCM).
# The key must be exactly 64 hexadecimal characters (32 bytes).
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NEVER use the default value in production. The app will fail to start if JWT_ENCRYPTION_KEY is not set.
JWT_ENCRYPTION_KEY=

# Database Configuration
NODE_ENV=development

# Server Configuration
PORT=3000

# Logging Configuration
# Log level: error, warn, info, http, verbose, debug, silly
LOG_LEVEL=debug

# Log format: json (structured) or pretty (human-readable)
LOG_FORMAT=pretty

# Enable/disable console output (default: true in development, false in production)
LOG_CONSOLE=true

# Enable/disable file logging (default: true)
LOG_TO_FILE=true

# Logs directory (default: ./logs)
LOGS_DIR=./logs

# Maximum log file size before rotation (e.g., 20m, 100k)
LOG_MAX_SIZE=20m

# Maximum number of days to keep log files
LOG_MAX_FILES=14d
