# KANYR Backend Environment Variables
# Development configuration

# Database
DATABASE_URL=sqlite:./database.sqlite
NODE_ENV=development

# JWT Configuration
JWT_SECRET=kanyr_development_secret_key_2026_min_32_characters_required
JWT_EXPIRES_IN=24h

# Server
PORT=3000

# CORS - Frontend URLs
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Logging
LOG_LEVEL=debug

# Admin User (For seeding - change in production!)
ADMIN_EMAIL=admin@kanyr.hu
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@123456

# Notes:
# - Change JWT_SECRET in production to a strong random string
# - Change ADMIN_PASSWORD in production
# - Add your production ALLOWED_ORIGINS
